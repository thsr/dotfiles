// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },

  // %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  "text_rendering_mode": "grayscale",
  "buffer_font_family": "Agave",
  "buffer_font_features": {
    "calt": false,
    "liga": false,
    "dlig": false,
    "clig": false,
    "hlig": false
  },
  "buffer_font_size": 17,
  "buffer_font_weight": 500,
  "buffer_line_height": "standard",
  "ui_font_family": "Trebuchet MS",
  // "ui_font_size": 16,
  "ui_font_weight": 500,
  "theme": {
    "mode": "dark",
    "light": "Plaster BG High Contrast",
    "dark": "Plaster Dark Green"
  },
  "theme_overrides": {
    "Gruvbox Light": {
      "editor.invisible": "#00000020",
    },
    "Gruvbox Dark": {
      "editor.invisible": "#ffffff20",
    },
  },
  "icon_theme": {
    "mode": "light",
    "light": "File Icons Light",
    "dark": "Bearded Icons"
  },
  "active_pane_modifiers": {
    "inactive_opacity": 0.5
  },
  "window_decorations": "server",
  "cli_default_open_behavior": "new_window",
  "show_wrap_guides": true,
  "show_whitespaces": "boundary",
  "indent_guides": {
    "coloring": "indent_aware",
    "active_line_width": 3,
    "line_width": 3
  },

  // %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  "format_on_save": "off",
  "remove_trailing_whitespace_on_save": true,
  "languages": {
    "Go": {
      "format_on_save": "on",
      "tab_size": 4,
      "formatter": "language_server",
      "code_actions_on_format": { "source.organizeImports": true },
    },
    "JSON": {
      "format_on_save": "on"
    },
    "Python": {
      // "format_on_save": "on",
      "hard_tabs": false,
      "tab_size": 4,
      "language_servers": ["basedpyright", "ruff"],
      "formatter": { "language_server": { "name": "ruff" } },
      "code_actions_on_format": { "source.organizeImports.ruff": true },
    },
  },
  "lsp_document_colors": "background",

  // %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  "vim_mode": false,
  "vim": {
    "highlight_on_yank_duration": 500,
    "toggle_relative_line_numbers": true,
  },
  "helix_mode": false,
  "base_keymap": "VSCode",
  // "cursor_blink": false,
  // "cursor_shape": "block",
  "project_panel": {
    "auto_reveal_entries": true,
    "git_status": true,
    "file_icons": true,
    "entry_spacing": "standard",
    "hide_gitignore": false,
    "dock": "left",
  },
  "preview_tabs": { "enable_preview_from_file_finder": false },
  "git_panel": {
    "group_by": "none",
    "sort_by": "name",
    "dock": "left",
    "tree_view": true,
  },
  "minimap": {
    "max_width_columns": 50,
    "show": "always",
  },
  "proxy": "",
  "git": { "inline_blame": { "enabled": false } },
  "title_bar": {
    "show_menus": true,
    "show_user_picture": true,
    "show_user_menu": true,
    "show_sign_in": true,
    "show_onboarding_banner": true,
    "show_branch_name": true,
    "show_project_items": true,
    "show_branch_status_icon": true,
  },
  "toolbar": {
    "breadcrumbs": true,
    "code_actions": true
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "search": { "button": true },
  "debugger": { "button": true },
  "status_bar": { "show_active_file": true },
  "rounded_selection": false,

  // %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  "edit_predictions": {
    "provider": "copilot",
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    },
    "auggie": {
      "type": "registry"
    },
    "gemini": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "model": "haiku",
        "mode": "default",
        "effort": "high",
      },
      "type": "registry",
    },
  },
  "agent": {
    "threads_sidebar": { "position": "right" },
    "thinking_display": "always_collapsed",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
}
