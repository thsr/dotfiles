// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "vim_mode": false,
  "languages": {
    "JSON": {
      "format_on_save": "on"
    },
  },
  "indent_guides": {
    "coloring": "indent_aware",
    "active_line_width": 2,
    "line_width": 2
  },
  "helix_mode": false,
  "show_whitespaces": "boundary",
  "base_keymap": "VSCode",
  // "vim_mode": true,
  "vim": {
    "highlight_on_yank_duration": 500,
    "toggle_relative_line_numbers": true,
  },
  // "cursor_blink": false,
  "format_on_save": "off",
  "git_panel": {
    "dock": "left",
    "tree_view": false,
  },
  "show_wrap_guides": true,
  "edit_predictions": {
    "provider": "copilot",
  },
  "remove_trailing_whitespace_on_save": true,
  "toolbar": {
    "breadcrumbs": true,
    "code_actions": true
  },
  "minimap": {
    "max_width_columns": 50,
    "show": "always",
  },
  "proxy": "",
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": false,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "title_bar": {
    "show_menus": true,
    "show_user_picture": true,
    "show_user_menu": true,
    "show_sign_in": true,
    "show_onboarding_banner": true,
    "show_branch_name": true,
    "show_project_items": true,
    "show_branch_status_icon": true,
  },
  "search": {
    "button": true,
  },
  "debugger": {
    "button": true,
  },
  "status_bar": {
    "show_active_file": true,
  },
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "rounded_selection": false,
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    },
    "auggie": {
      "type": "registry"
    },
    "gemini": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "model": "haiku",
        "mode": "default",
        "effort": "high",
      },
      "type": "registry",
    },
  },
  "agent": {
    "thinking_display": "always_collapsed",
    "dock": "right",
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "project_panel": {
    "auto_reveal_entries": true,
    "git_status": true,
    "file_icons": true,
    "entry_spacing": "standard",
    "hide_gitignore": false,
    "dock": "left",
  },
  "lsp_document_colors": "background",
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_features": {
      "calt": false,
      "liga": false
    },
  // "buffer_font_size": 13.0,
  "buffer_font_weight": 500.0,
  "buffer_line_height": "standard",
  // "ui_font_family": "Geist",
  // "ui_font_size": 17.0,
  "ui_font_weight": 500.0,
  "theme": {
    "mode": "light",
    "light": "Alabaster ALT BG High Contrast (chill Marks)",
    "dark": "Alabaster Dark"
  },
  "theme_overrides": {
    "Gruvbox Light": {
      "editor.invisible": "#00000020",
    },
    "Gruvbox Dark": {
      "editor.invisible": "#ffffff20",
    },
  },
  "icon_theme": {
    "mode": "light",
    "light": "File Icons Light",
    "dark": "Bearded Icons"
  },
  "active_pane_modifiers": {
    "inactive_opacity": 0.5
  },
  "window_decorations": "server",
}
