[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-o": "project_panel::Toggle",
      "ctrl-alt-p": "git_panel::Toggle",

      "ctrl-alt-[": "workspace::ToggleLeftDock",
      "ctrl-alt-]": "workspace::ToggleRightDock",
      "ctrl-alt-'": "workspace::ToggleBottomDock",
      "ctrl-alt-\\": "multi_workspace::ToggleWorkspaceSidebar",

      "alt-home": "editor::MoveToStartOfParagraph",
      "alt-end": "editor::MoveToEndOfParagraph",

      "ctrl-space v": "workspace::ToggleVimMode",

      "ctrl-space g": "git_panel::Toggle",
      "ctrl-space e": "editor::ToggleFocus",
      "ctrl-space l": "language_selector::Toggle",

      "ctrl-space c l": "editor::ConvertToLowerCase",
      "ctrl-space c u": "editor::ConvertToUpperCase",

      "ctrl-space p": "project_panel::Toggle",
      // "ctrl-space z t": "editor::ScrollCursorTop",
      // "ctrl-space z z": "editor::ScrollCursorCenter",
      // "ctrl-space z b": "editor::ScrollCursorBottom",
      "ctrl-space z": "editor::ScrollCursorTop",

    },
  },
  {
    "context": "AcpThread > Editor",
    "unbind": {
      "ctrl-'": "agent::CycleThinkingEffort"
    }
  },
  {
    "context": "AcpThread > Editor",
    "unbind": {
      "ctrl-;": "agent::OpenAddContextMenu"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-;": "editor::ToggleLineNumbers"
    }
  }
]
